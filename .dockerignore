# Секреты: переменные приходят через env_file в compose, в образ не копируются.
.env
.env.*
!.env.docker.example
!.env.example
!.env.local.example

# VCS / IDE
.git
.gitignore
.github
.idea
.vscode

# SSL certificates (never commit)
nginx/ssl/
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python-мусор
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Node.js
node_modules/
frontend/node_modules/

# Logs
*.log
npm-debug.log*
server_error.log
server_output.log

# Не нужно в рантайме
tests/
docs/
archive/
*.md
requirements-dev.txt
requirements-bot.txt
pytest.ini
.pre-commit-config.yaml
docker-compose*.yml
Dockerfile
backend.Dockerfile
worker.Dockerfile
frontend.Dockerfile
# Exclude root nginx.conf but allow frontend/nginx.conf
/nginx.conf
nginx/nginx.conf
deploy/nginx.conf
