# Дополнения к .env для docker compose (значения подставь свои, .env в git не коммить).

# --- обязательное для compose ---
# Только буквы и цифры (пароль попадает в URL redis://:PASSWORD@redis:6379/0).
# Сгенерировать:  python -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=

# --- необязательное ---
# API_BIND=127.0.0.1      # 0.0.0.0 только если порт открыт наружу без reverse proxy
# API_PORT=8000
# WEB_CONCURRENCY=2

# --- переменные приложения (как в твоём рабочем .env) ---
# GEMINI_API_KEY=
# SUPABASE_URL=
# DATABASE_URL=postgresql+asyncpg://app_tenant.<ref>:<pwd>@<pooler-host>:6543/postgres?ssl=require
# REDIS_URL — задавать не нужно: compose подставляет redis://:PASSWORD@redis:6379/0
#
# Если DATABASE_URL у тебя указывает на localhost, из контейнера эта БД недоступна:
# используй внешний адрес (Supabase pooler) или host.docker.internal.
