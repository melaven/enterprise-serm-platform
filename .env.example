# База данных (PostgreSQL с asyncpg)
# Основная URL для роли postgres (миграции, админка)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/serm_db

# URL для роли app_tenant (runtime, изолированный доступ через RLS)
TENANT_DATABASE_URL=postgresql+asyncpg://app_tenant:your_tenant_password@localhost:5432/serm_db

# Использовать tenant роль для runtime (по умолчанию true)
USE_TENANT_ROLE=true

# SQL Echo для отладки (включает логирование SQL запросов)
SQL_ECHO=false

# Redis для ARQ фоновых задач
REDIS_URL=redis://localhost:6379/0

# OpenAI API для генерации ответов
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Настройки аутентификации JWT
# Для RS256 (рекомендуется для продакшена)
AUTH_JWT_ALGORITHM=RS256
AUTH_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/jwks

# Для HS256 (legacy, только для разработки)  
# AUTH_JWT_ALGORITHM=HS256
# AUTH_JWT_SECRET=your-jwt-secret-key

# Настройки приложения  
DEBUG=true
LOG_LEVEL=INFO

# SERM параметры (опционально)
DEFAULT_LOST_LEADS_COEFFICIENT=5
DEFAULT_POSITIVE_BOOST_COEFFICIENT=0.5

# Supabase (опционально)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key