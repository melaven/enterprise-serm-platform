# Copy this file to .env and fill in the values for your environment.
# Never commit .env or put production credentials in this template.

# --- PostgreSQL / tenant roles ---
POSTGRES_USER=tenable
POSTGRES_PASSWORD=replace_with_a_unique_postgres_password
POSTGRES_DB=tenable
APP_TENANT_PASSWORD=replace_with_a_unique_tenant_password
# Admin DSN: used only by the migration service.
DATABASE_URL=postgresql+asyncpg://tenable:replace_with_a_unique_postgres_password@db:5432/tenable
# Runtime DSN: API and ARQ worker connect with the non-superuser RLS role.
TENANT_DATABASE_URL=postgresql+asyncpg://app_tenant:replace_with_a_unique_tenant_password@db:5432/tenable
USE_TENANT_ROLE=true

# --- Supabase authentication ---
SUPABASE_URL=https://example.supabase.co
SUPABASE_JWT_SECRET=replace_with_your_supabase_jwt_secret
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

# --- SQLAdmin ---
# Configure all three values to enable admin login at /admin.
# Generate a random session secret, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# --- Redis / ARQ ---
REDIS_PASSWORD=replace_with_a_unique_redis_password
REDIS_URL=redis://127.0.0.1:6379/0
API_PORT=8000

# --- LLM providers ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173
ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Production reverse proxy ---
SERVER_NAME=api.example.com
TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com
# ACME_WEBROOT=./infra/nginx/acme
# APP_VERSION=latest
# WEB_CONCURRENCY=2
# API_MEM_LIMIT=1g
# WORKER_MEM_LIMIT=1g
# POSTGRES_MAX_CONNECTIONS=100
# Billing DSN must use the dedicated restricted billing_service role.
BILLING_DATABASE_URL=
APIKEY_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
BROWSERLESS_TOKEN=

# --- Optional integrations ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serm-platform.com
SMTP_USE_TLS=true
TG_BOT_TOKEN=
TG_API_BASE_URL=http://127.0.0.1:8000
# TG_COMPANY_ID=
# TG_API_TOKEN=
# TG_ALLOWED_USER_IDS=
# TWOGIS_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
