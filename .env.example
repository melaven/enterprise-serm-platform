# Local PostgreSQL settings for docker-compose.yml
POSTGRES_USER=serm_user
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=serm_db
APP_TENANT_PASSWORD=replace-with-a-different-url-safe-password

# Host connections used by scripts/migrate.py and scripts/seed_db.py
DATABASE_URL=postgresql+asyncpg://serm_user:replace-with-a-local-database-password@localhost:5432/serm_db
TENANT_DATABASE_URL=postgresql+asyncpg://app_tenant:replace-with-a-different-url-safe-password@localhost:5432/serm_db
USE_TENANT_ROLE=true
SQL_ECHO=false

# Redis for ARQ background jobs
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_URL=redis://:replace-with-a-local-redis-password@localhost:6379/0

# AI providers
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
YANDEX_OAUTH_CLIENT_ID=your-yandex-oauth-client-id
YANDEX_OAUTH_CLIENT_SECRET=your-yandex-oauth-client-secret

# Authentication. Configure a real JWKS URL for deployed environments.
AUTH_JWT_ALGORITHM=RS256
AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks

# Application settings
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true
LOG_LEVEL=INFO
DEFAULT_LOST_LEADS_COEFFICIENT=5
DEFAULT_POSITIVE_BOOST_COEFFICIENT=0.5

# Optional Supabase integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
