# Copy this file to .env and fill in the values for your environment.
# Never commit .env or put production credentials in this template.

# --- Application database ---
# Local/Supabase development:
DATABASE_URL=postgresql+asyncpg://app_tenant.<project-ref>:<password>@<pooler-host>:6543/postgres?ssl=require
# Optional dedicated tenant DSN; defaults to DATABASE_URL when omitted.
# TENANT_DATABASE_URL=
# USE_TENANT_ROLE=true
# Docker production: set DATABASE_URL to the app_tenant role on postgres:5432.
# The role/schema must be provisioned before running migrations or the app.
# DATABASE_URL=postgresql+asyncpg://app_tenant:<password>@postgres:5432/tenable
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_AUDIENCE=authenticated

# --- Redis / ARQ ---
# Local development: run Redis locally or use dummy://skip to disable worker enqueueing.
REDIS_URL=redis://127.0.0.1:6379/0
# Docker Compose overrides REDIS_URL to use the redis service and REDIS_PASSWORD below.
# REDIS_URL=redis://:change_me@redis:6379/0
REDIS_PASSWORD=

# --- LLM providers ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional OpenAI-compatible provider override. Groq is used by default when GROQ_API_KEY is set.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173
ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Docker production profile ---
# Required by docker-compose.prod.yml. Set these before starting the production stack.
POSTGRES_USER=tenable
POSTGRES_PASSWORD=
POSTGRES_DB=tenable
SERVER_NAME=api.example.com
TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com
# ACME_WEBROOT=./infra/nginx/acme
# APP_VERSION=latest
# WEB_CONCURRENCY=2
# API_MEM_LIMIT=1g
# WORKER_MEM_LIMIT=1g
# POSTGRES_MAX_CONNECTIONS=100
# Billing DSN must use the dedicated restricted billing_service role.
BILLING_DATABASE_URL=
APIKEY_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
BROWSERLESS_TOKEN=replace_with_browserless_token

# --- Optional integrations ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serm-platform.com
SMTP_USE_TLS=true
TG_BOT_TOKEN=
TG_API_BASE_URL=http://127.0.0.1:8000
# TG_COMPANY_ID=
# TG_API_TOKEN=
# TG_ALLOWED_USER_IDS=
# TWOGIS_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
