# Production configuration template. Copy to .env.prod and replace placeholders.
# Never commit real credentials or encryption keys.

# Fernet key for encrypting stored platform tokens (required where token encryption is used).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Restricted database connections for B2B API key validation and Stripe webhooks.
# Use the dedicated apikey_service and billing_service roles, not the application tenant role.
APIKEY_DATABASE_URL=
BILLING_DATABASE_URL=

# SMTP settings for email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@serm-platform.com

# Telegram bot token for Telegram alerts.
TELEGRAM_BOT_TOKEN=
