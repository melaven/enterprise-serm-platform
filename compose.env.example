# Copy to .env.compose. Set unique passwords before starting the stack.
POSTGRES_USER=tenable
POSTGRES_PASSWORD=
POSTGRES_DB=tenable
APP_TENANT_PASSWORD=

# Use URL-encoded passwords in these PostgreSQL URLs.
# The admin URL is used only by the one-shot migration container.
LOCAL_ADMIN_DATABASE_URL=
# The app_tenant URL is used by the API and worker, never the admin URL.
LOCAL_TENANT_DATABASE_URL=

API_PORT=8000
ENVIRONMENT=development
