# Добавь в .env (рядом с переменными бэкенда). Все переменные бота с префиксом TG_.
TG_BOT_TOKEN=123456789:AA...          # токен от @BotFather
TG_API_BASE_URL=http://127.0.0.1:8000 # именно 127.0.0.1, не localhost (IPv6 на Windows)
TG_COMPANY_ID=00000000-0000-0000-0000-000000000001  # тестовый company_id
# TG_API_TOKEN=                        # если бэкенд требует Bearer-токен
# TG_ALLOWED_USER_IDS=111111111,222222222  # твой Telegram id (узнай у @userinfobot)
# TG_POLL_INTERVAL=3
# TG_POLL_TIMEOUT=300
