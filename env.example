# Локальная разработка. Скопируйте в .env (файл в .gitignore, в репозиторий не коммитить).
POSTGRES_USER=tenable
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=tenable
POSTGRES_PORT=5432

# Runtime приложения. Пароль и порт должны совпадать со значениями выше.
DATABASE_URL=postgresql+asyncpg://tenable:change_me_local@localhost:5432/tenable

# Необязательно: отдельный DSN владельца схемы для Alembic (по умолчанию берётся DATABASE_URL).
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://tenable:change_me_local@localhost:5432/tenable
