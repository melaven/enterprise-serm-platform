# Шаблон .env для docker-compose.prod.yml. Скопируй в .env (в git не коммить), заполни ВСЕ значения.
# Сгенерировать пароль:  python -c "import secrets; print(secrets.token_hex(24))"

# --- compose / инфраструктура ---
SERVER_NAME=api.example.com            # домен, на который выпущен сертификат
TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com   # каталог с fullchain.pem и privkey.pem
# ACME_WEBROOT=./nginx/acme
# APP_VERSION=latest
# WEB_CONCURRENCY=2

# Только буквы и цифры (пароли попадают в URL).
REDIS_PASSWORD=
POSTGRES_USER=tenable
POSTGRES_PASSWORD=
POSTGRES_DB=tenable

# --- приложение ---
# DATABASE_URL: БД из этого compose -> postgresql+asyncpg://<роль app_tenant>:<пароль>@postgres:5432/<POSTGRES_DB>
#               Supabase -> postgresql+asyncpg://app_tenant.<ref>:<pwd>@<pooler-host>:6543/postgres?ssl=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
BILLING_DATABASE_URL=
APIKEY_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
APP_BASE_URL=https://app.example.com
# REDIS_URL задавать не нужно: compose подставляет redis://:PASSWORD@redis:6379/0
