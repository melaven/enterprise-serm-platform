# ========================================
# Docker Ignore для оптимизации сборки
# ========================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (собирается внутри контейнера)
dist
build
.vite

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output
*.test.js
*.spec.js
__tests__
__mocks__

# Environment files (используй docker secrets/env vars)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Documentation
README.md
CHANGELOG.md
docs

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Misc
*.log
.cache
.temp
tmp
