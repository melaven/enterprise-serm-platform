    {
      "name": "Multi-Tenant Isolation Tests",
      "item": [
        {
          "name": "Test Cross-Tenant Data Isolation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/companies/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "companies", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('RLS isolation - should only return tenant data', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    ",
                  "    // Если есть данные, они должны принадлежать текущему tenant",
                  "    if (jsonData.data.length > 0) {",
                  "        jsonData.data.forEach(company => {",
                  "            // Проверяем, что company_id соответствует текущему tenant",
                  "            // (в реальной системе это может быть скрытое поле)",
                  "            pm.expect(company).to.have.property('id');",
                  "        });",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response should not exceed expected tenant data count', function () {",
                  "    const jsonData = pm.response.json();",
                  "    // В тестовом tenant должно быть ограниченное количество записей",
                  "    pm.expect(jsonData.data.length).to.be.at.most(100);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
