    {
      "name": "Reviews API (Multi-Tenant)",
      "item": [
        {
          "name": "Create Review via Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_review_id\": \"test-review-001\",\n  \"company_id\": \"{{company_id}}\",\n  \"platform_id\": \"{{platform_id}}\",\n  \"author\": \"Test User\",\n  \"content\": \"Отличный сервис! Быстро и качественно выполнили работу.\",\n  \"rating\": 5,\n  \"created_at\": \"2026-10-10T15:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews", "webhook"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response indicates success', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Review ID returned', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('review_id');",
                  "    pm.globals.set('review_id', jsonData.data.review_id);",
                  "});"
